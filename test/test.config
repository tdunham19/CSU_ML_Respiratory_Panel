params {

  // positive control fastq for testing
  fastq_dir = "${baseDir}/test/fastq/"
  
  // reference file for pipeline testing
  reference = "${baseDir}/test/ML_BVDV_Herpes_Mbovis_Subset.fasta"
  
  // barcode file for pipeline testing
  barcode = "${baseDir}/test/ML2100_ON_Index_Subset.fasta"

  // put testing results in test_results folder
  outdir = "${baseDir}/test/results"
  
  // minimum number of reads to demultiplex to keep a barcode in the workflow
  params.min_demux_reads = 20

}