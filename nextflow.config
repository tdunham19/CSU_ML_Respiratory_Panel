singularity.enabled=true

params {

  // -------------------------
  // input/output directories
  // -------------------------
  outdir	          = "$baseDir/results/" 
  indiv_ref_dir       = "$baseDir/results/individual_references/" 
  outputDir           = "$outdir"
  publish_dir_mode    = "link"
  
  // default platform, reference, and fastq directory
  fastq_dir        = "null"
  reference        = "null"
  barcode          = "null"

  // pattern to match for fastq files
  nanopore_input_pattern    = "*.fastq*"
  
  // minimum number of reads to demultiplex to keep a barcode in the workflow
  params.min_demux_reads = 20

  // ------------------------------------------------
  // viral_consensus-related parameters
  // see: https://github.com/niemasd/ViralConsensus
  // and: doi:10.1093/bioinformatics/btad317
  // ------------------------------------------------

  // minimum quality score for a base to contribute to consensus calling
  // since nanopore data, keep lower than for illumina
  nanopore_min_qual    =  5
  
  // minimum depth to call a consensus base at a position
  nanopore_min_depth   =  2

  // minimum frequency to call a consensus base at a position
  // 25% consensus: plurality base, must be >25%
  nanopore_min_freq    =  0.25
  
  // ------------------------------------------------
  // params for conclusion cutoffs
  // ------------------------------------------------
  params.reads_yes_cutoff   = 100
  params.reads_suspect_cutoff = 0
  
}

  // include a test profile
  profiles {
  test { 
    includeConfig 'test/test.config'
    }
  }

process {
   // setup saving output files
   withLabel: '!no_publish' {
      publishDir = [
          path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
          mode: params.publish_dir_mode,
      ]
   }
   
   // save final output files from nanopore workflow
	withName: 'NANOPORE_WORKFLOW:NANOPLOT_PRE_TRIM' {
     publishDir = [
		 [
         path:    { "${params.outdir}/quality_control/pre_trim" },
         mode:    "link",
         pattern: "*.html"
       ]
	  ]
   }
   
   // save final output files from nanopore workflow
	withName: 'NANOPORE_WORKFLOW:TRIM_ARMS' {
     publishDir = [
		 [
         path:    { "${params.outdir}/final_trimmed_reads" },
         mode:    "link",
         pattern: "*.fastq.gz"
       ]
	  ]
   }
   
   // save final output files from nanopore workflow
	withName: 'NANOPORE_WORKFLOW:NANOPLOT_POST_TRIM' {
     publishDir = [
		 [
         path:    { "${params.outdir}/quality_control/post_trim" },
         mode:    "link",
         pattern: "*.html"
       ]
	  ]
   }
   
   // save final output files from nanopore workflow
	withName: 'NANOPORE_WORKFLOW:MINIMAP2_ALIGN_TO_REF' {
     publishDir = [
		 [
         path:    { "${params.outdir}/aligned_to_ref" },
         mode:    "link",
         pattern: "*.bam"
       ]
	  ]
   }
   
   // save final output files from nanopore workflow
	withName: 'NANOPORE_WORKFLOW:REMOVE_TRAILING_FASTA_NS' {
     publishDir = [
		 [
         path:    { "${params.outdir}/consensus_sequences" },
         mode:    "link",
         pattern: "*.fa"
       ]
	  ]
   }
   
   // save final output files from nanopore workflow
	withName: 'NANOPORE_WORKFLOW:MERGE_SUMMARIES' {
     publishDir = [
		 [
         path:    { "${params.outdir}/" },
         mode:    "link",
         pattern: "*.tsv"
       ]
	  ]
   }
}